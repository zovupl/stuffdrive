rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каталог машин: читать могут все, писать — только сервер (Apps Script) / владелец
    match /cars/{carId} {
      allow read: if true;
      allow write: if false;
    }
    // Занятые даты по машинам (только интервалы, без личных данных): читать могут все
    match /availability/{carId} {
      allow read: if true;
      allow write: if false;
    }
    // Заявки: создаются, читаются и меняются ТОЛЬКО сервером (вебхук проверяет занятость дат)
    match /bookings/{bookingId} {
      allow read, create, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
